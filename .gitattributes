# Manejo de saltos de linea uniforme para entornos Linux/Unix
* text=auto eol=lf

# Scripts bash obligatoriamente con salto de linea LF
*.sh text eol=lf
*.bash text eol=lf

# Configuraciones de contenedores y declaracion
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.env* text eol=lf
*.json text eol=lf

# Documentacion y codigo
*.md text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
