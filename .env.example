# ==============================================================================
# HOMELAB RASPBERRY PI 5 - CONFIGURACIÓN DE ENTORNO
# Copia este archivo a .env antes de ejecutar deploy.sh: cp .env.example .env
# ==============================================================================

# --- CONFIGURACIÓN DE RED Y HOTSPOT WI-FI ---
HOTSPOT_SSID="RPi5-TeamNetwork"
HOTSPOT_PASSWORD="TeamWorkSecure2026"
HOTSPOT_GATEWAY_IP="192.168.4.1/24"
PORTAL_PORT=8080
PORTAL_ACCESS_PASSWORD="TeamAccess2026"

# --- LOCAL SEND / PAIRDROP (WEB FILE SHARING) ---
PAIRDROP_PORT=3000
PAIRDROP_BIND_IP=0.0.0.0

# --- SEGURIDAD: ENLACE DE PUERTOS PRIVADOS ---
# Al enlazar a 127.0.0.1, estos puertos quedan completamente invisibles para escaneos
# desde tu red local o internet. Solo son accesibles mediante Tailscale.
PRIVATE_BIND_IP=127.0.0.1

# --- OBSIDIAN LIVESYNC (COUCHDB) ---
COUCHDB_PORT=5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=SuperSecureObsidianPass2026!
OBSIDIAN_BIND_IP=127.0.0.1

# --- GESTOR WEB DE CONTENEDORES (DOCKGE) ---
DOCKGE_PORT=5001
MANAGEMENT_BIND_IP=127.0.0.1

# --- CI/CD (GITEA & JENKINS) ---
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2222
GITEA_BIND_IP=127.0.0.1
JENKINS_PORT=8081
JENKINS_BIND_IP=127.0.0.1

# --- SEGURIDAD DNS (PI-HOLE) ---
PIHOLE_WEB_PORT=8082
PIHOLE_BIND_IP=127.0.0.1
PIHOLE_PASSWORD=AdminPiholePass2026!

# --- ASISTENTE IA (LLAMA.CPP) ---
AI_PORT=8000
AI_BIND_IP=127.0.0.1
LLAMA_MODEL_FILE=LFM2.5-2.6B-Q_4_K_M.gguf

# --- TAILSCALE OPCIONAL (Para registro no interactivo) ---
# Si generas una Auth Key en el panel de Tailscale, el script la usará automáticamente:
TAILSCALE_AUTHKEY=
